[Unit]
Description=My custom nginx lab service
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/nginx-lab/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/nginx-lab/nginx.conf -g 'daemon off;'
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
